---
import Page from '../layouts/Page.astro';
import { POLICY_SOURCE, renderPolicy } from '../lib/policy.ts';

// CONTRIBUTING.md is the single source for the inclusion criteria and the style guide.
const policy = renderPolicy(__SITE_ROOT__);
const sections = policy.headings.filter((h) => h.depth === 2);
---

<Page title="Policy" description="What belongs in the list, the style guide for entries, and how entries are kept current." current="policy">
  <div class="col">
    <header class="page-head hang">
      <a class="mn label" href={POLICY_SOURCE} rel="noopener">Contributing.md</a>
      <h1 class="page-title">Policy</h1>
    </header>

    <nav class="contents" aria-label="On this page">
      <ol>
        {
          sections.map((h, i) => (
            <li class="hang">
              <span class="mn" aria-hidden="true">§{i + 1}</span>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    <article class="prose" set:html={policy.html} />
  </div>
</Page>

<style>
  .contents {
    padding-top: 12px;
    border-top: 1px solid var(--ink);
  }

  .contents li {
    padding: 3px 0;
    font-size: var(--fs-small);
  }

  .contents .mn {
    color: var(--muted);
  }

  @media (max-width: 759px) {
    .contents .mn {
      display: inline;
      margin-right: 0.6em;
    }
  }
</style>

<style is:global>
  /* CONTRIBUTING.md, set as a long-form page. */
  .prose {
    counter-reset: sec;
    margin-top: 24px;
  }

  .prose > * + * {
    margin-top: 1em;
  }

  .prose p,
  .prose li {
    max-width: 34em; /* about 75 characters at 19px */
  }

  .prose h2 {
    position: relative;
    margin-top: 72px;
    padding-top: 14px;
    border-top: 1px solid var(--ink);
    font-size: var(--fs-h2);
    line-height: 1.15;
    counter-increment: sec;
  }

  .prose h2::before {
    content: '§' counter(sec) / '';
    position: absolute;
    top: 14px;
    right: calc(100% + var(--gutter));
    font-weight: 300;
    color: var(--muted);
  }

  .prose h2 + * {
    margin-top: 18px;
  }

  .prose h3 {
    margin-top: 40px;
    font-size: 1.375rem;
    line-height: 1.25;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose ul {
    padding: 0;
    list-style: none;
  }

  .prose ul > li {
    position: relative;
  }

  .prose ul > li::before {
    content: '–' / '';
    position: absolute;
    left: -1.1em;
    color: var(--muted);
  }

  .prose ol {
    padding-left: 1.4em;
  }

  .prose li + li {
    margin-top: 0.45em;
  }

  .prose code {
    font-family: var(--mono);
    font-size: max(var(--fs-mono), 0.8em);
  }

  .prose pre {
    padding: 12px 0 12px 18px;
    border-left: 2px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.875rem;
    line-height: 1.65;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .prose pre code {
    font-size: inherit;
  }

  .table-wrap {
    margin-top: 1.5em;
    overflow-x: auto;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .prose th {
    padding: 0 16px 8px 0;
    border-bottom: 1px solid var(--ink);
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 400;
    letter-spacing: var(--track);
    text-transform: uppercase;
    text-align: left;
    color: var(--muted);
  }

  .prose td {
    padding: 10px 16px 12px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    text-wrap: pretty;
  }

  .prose td:first-child {
    width: 12em;
    font-weight: 600;
  }

  @media (max-width: 759px) {
    .prose h2::before {
      position: static;
      display: block;
      margin-bottom: 4px;
      font-family: var(--mono);
      font-size: var(--fs-mono);
      font-weight: 400;
    }

    .prose ul {
      padding-left: 1.1em;
    }

    .prose thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .prose tr,
    .prose td {
      display: block;
    }

    .prose tr {
      padding: 10px 0 12px;
      border-bottom: 1px solid var(--rule);
    }

    .prose td,
    .prose td:first-child {
      width: auto;
      padding: 0;
      border: 0;
    }

    .prose td + td {
      margin-top: 4px;
    }
  }
</style>
