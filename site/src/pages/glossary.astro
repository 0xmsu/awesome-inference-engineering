---
import Page from '../layouts/Page.astro';
import { glossaryId, site } from '../lib/data.ts';
import type { GlossaryTerm } from '../lib/types.ts';

// Alphabetical, grouped by initial letter, as in a dictionary.
const sortKey = (t: GlossaryTerm) => t.term.toLowerCase().normalize('NFKD');
const terms = [...site.glossary].sort((a, b) => sortKey(a).localeCompare(sortKey(b), 'en'));
const letters = new Map<string, GlossaryTerm[]>();
for (const t of terms) {
  const letter = t.term.normalize('NFKD').charAt(0).toUpperCase();
  if (!letters.has(letter)) letters.set(letter, []);
  letters.get(letter)?.push(t);
}
const byTerm = new Map(site.glossary.map((t) => [t.term.toLowerCase(), t]));
---

<Page title="Glossary" description="Short definitions of the terms used across inference engineering, from prefill and decode to MFU and microscaling formats." current="glossary">
  <div class="col">
    <header class="page-head">
      <h1 class="page-title">Glossary</h1>
      <p class="label page-count">{terms.length} terms</p>
    </header>

    <nav class="thumbs label" aria-label="Letters">
      {[...letters.keys()].map((l, i) => <>{i > 0 && ' '}<a href={`#letter-${l.toLowerCase()}`}>{l}</a></>)}
    </nav>

    {
      [...letters.entries()].map(([letter, group]) => (
        <section class="letter" id={`letter-${letter.toLowerCase()}`} aria-label={letter}>
          <p class="letter-mark" aria-hidden="true">{letter}</p>
          <dl>
            {group.map((t) => (
              <div class="term" id={glossaryId(t.term)}>
                <dt>
                  <dfn>{t.term}</dfn>
                  {t.aka?.length ? <span class="aka"> ({t.aka.join(', ')})</span> : null}
                </dt>
                <dd>
                  {t.definition}
                  {t.see?.length ? (
                    <span class="see">
                      {' '}See also{' '}
                      {t.see.map((s, i) => <>{i > 0 && ', '}{byTerm.has(s.toLowerCase()) ? <a href={`#${glossaryId(s)}`}>{s}</a> : s}</>)}.
                    </span>
                  ) : null}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
  </div>
</Page>

<style>
  .thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 4px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
  }

  /* Each letter is a 24px target; the glyph stays on the column's left edge. */
  .thumbs a {
    display: inline-flex;
    align-items: center;
    min-width: 24px;
    min-height: 24px;
  }

  .letter {
    position: relative;
    padding: 18px 0 6px;
    border-bottom: 1px solid var(--rule);
  }

  .letter-mark {
    position: absolute;
    top: 12px;
    right: calc(100% + var(--gutter));
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1;
    color: var(--muted);
  }

  .term {
    max-width: 33em;
    margin-bottom: 14px;
    padding-left: 1.25em;
    text-indent: -1.25em;
    font-size: var(--fs-desc);
    line-height: 1.55;
  }

  dt,
  dd {
    display: inline;
    margin: 0;
  }

  dfn {
    font-style: normal;
    font-weight: 600;
  }

  .aka {
    font-style: italic;
  }

  dt::after {
    content: '  ';
    white-space: pre;
  }

  :target {
    scroll-margin-top: 24px;
  }

  .term:target dfn {
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 759px) {
    .letter-mark {
      position: static;
      margin-bottom: 6px;
      font-family: var(--mono);
      font-size: var(--fs-mono);
      line-height: 1.5;
      letter-spacing: var(--track);
    }
  }
</style>
