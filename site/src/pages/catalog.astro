---
import Page from '../layouts/Page.astro';
import Entry from '../components/Entry.astro';
import { withBase } from '../lib/base.ts';
import { catalogPayload, isListed, site } from '../lib/data.ts';
import { facetDefs, SORT_OPTIONS } from '../lib/facets.ts';
import { SHORT } from '../lib/stack.ts';

const defs = facetDefs(catalogPayload()).map((def) =>
  def.id === 'section' ? { ...def, values: def.values.map((v) => ({ ...v, label: SHORT[v.value] ?? v.label })) } : def,
);
const OPEN = new Set(['section', 'type']);
const SORT_LABEL: Record<string, string> = { curated: 'Curated', stars: 'Stars', updated: 'Updated', added: 'Added' };
const src = withBase('catalog-index.json');
const listed = site.listedCount;
// The first screens of the default list are in the HTML; the script renders the rest from the payload
// with the same renderer (lib/entry-html.ts), which keeps the page light on slow connections.
const FIRST = 24;
const firstScreens = site.entries.filter(isListed).slice(0, FIRST);
---

<Page title="Catalog" description={`All ${listed} entries, with filters by section, hardware, deployment, type, license and more.`} current="catalog" noSearch>
  <script slot="head" is:inline>
    // A filtered link (?q=…) would otherwise flash the full list before the script narrows it.
    if (location.search.length > 1) document.documentElement.classList.add('cat-pending');
  </script>

  <div class="cat" data-catalog data-src={src}>
    <div class="cat-head">
      <h1 class="cat-title">Catalog</h1>
      <form class="cat-q" role="search" data-query-form>
        <label class="vh" for="cat-q">Search the catalog</label>
        <input id="cat-q" name="q" type="search" placeholder={`Search ${listed} entries`} autocomplete="off" spellcheck="false" data-search data-query />
      </form>
    </div>

    <aside class="rail" aria-label="Filters">
      <details class="filters" open data-filters>
        <summary class="label">Filters <span data-active></span></summary>
        {
          defs.map((def) => (
            <details class="facet" open={OPEN.has(def.id)} data-facet={def.id}>
              <summary class="label">
                {def.label} <span class="on" data-on />
              </summary>
              <ul aria-label={def.label}>
                {def.values.map((v) => (
                  <li>
                    <label class="fv">
                      <input type="checkbox" name={def.id} value={v.value} disabled={v.count === 0} />
                      <span><span class="fv-l">{v.label}</span> <span class="count">{v.count}</span></span>
                    </label>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
      </details>
      <script is:inline>
        // Fold the filters on narrow screens before first paint; folding them later would shift the page.
        if (window.matchMedia('(max-width: 899px)').matches) document.currentScript.previousElementSibling.open = false;
      </script>
    </aside>

    <div class="cat-main">
      <div class="cat-bar label">
        <p class="cat-count" data-count>{listed} entries</p>
        <p class="vh" role="status" data-status></p>
        <fieldset class="sort">
          <legend class="vh">Sort</legend>
          <span aria-hidden="true">Sort</span>
          {
            SORT_OPTIONS.map((o) => (
              <label>
                <input class="vh" type="radio" name="sort" value={o.value} checked={o.value === 'curated'} />
                <span title={o.label}>{SORT_LABEL[o.value] ?? o.label}</span>
              </label>
            ))
          }
        </fieldset>
        <label class="check">
          <input type="checkbox" data-archived />
          <span>Show archived</span>
        </label>
        <button class="clear" type="button" data-clear hidden>Clear</button>
      </div>
      <ol class="entries results" data-results>
        {firstScreens.map((e) => <Entry entry={e} showSection />)}
      </ol>
      <noscript>
        <p class="nojs label"><a href={withBase('sections/')}>All entries by section</a></p>
      </noscript>
      <p class="empty" data-empty hidden>
        No entries match. <button class="clear" type="button" data-clear>Clear filters</button>
      </p>
    </div>
  </div>
</Page>

<script>
  import '../scripts/catalog.ts';
</script>

<style>
  /* Rail and results inside the 908px content box: 210 + 28 + 670. */
  .cat {
    display: grid;
    grid-template-columns: 210px minmax(0, 670px);
    grid-template-areas:
      'rail head'
      'rail main';
    column-gap: 28px;
    align-items: start;
    padding-top: 56px;
  }

  .cat-head {
    grid-area: head;
  }

  .rail {
    grid-area: rail;
    position: sticky;
    top: 0;
    max-height: 100vh;
    overflow-y: auto;
    padding: 6px 4px 24px 0;
    scrollbar-width: thin;
  }

  .cat-main {
    grid-area: main;
  }

  .cat-title {
    font-size: var(--fs-h1);
    line-height: 1.04;
    letter-spacing: -0.01em;
  }

  .cat-q {
    margin-top: 22px;
  }

  .cat-q input {
    width: 100%;
    padding: 4px 0 6px;
    border: 0;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    font-size: 1.5rem;
    line-height: 1.3;
    appearance: none;
  }

  .cat-q input::placeholder {
    color: var(--muted);
    font-style: italic;
    opacity: 1;
  }

  .cat-q input:focus {
    outline: none;
  }

  .cat-q input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .cat-q input::-webkit-search-cancel-button {
    appearance: none;
  }

  .cat-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 24px;
    row-gap: 6px;
    margin-top: 14px;
    margin-bottom: 16px;
  }

  .cat-count {
    color: var(--ink);
    min-width: 8.5em;
  }

  .sort {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9em;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .sort label {
    cursor: pointer;
  }

  .sort label span {
    color: var(--muted);
  }

  .sort label:hover span {
    color: var(--ink);
  }

  .sort input:checked + span {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .sort label:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .check {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    cursor: pointer;
  }

  .clear {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--underline);
    text-underline-offset: 0.3em;
    cursor: pointer;
  }

  .clear:hover {
    color: var(--accent);
  }

  .clear[hidden] {
    display: none;
  }

  .nojs {
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }

  .empty {
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-desc);
  }

  .empty .clear {
    font-family: var(--serif);
    font-size: inherit;
    text-transform: none;
    letter-spacing: 0;
  }

  /* Rail */
  .filters > summary {
    display: none;
  }

  .facet {
    padding: 10px 0 12px;
    border-top: 1px solid var(--rule);
  }

  .facet:first-of-type {
    border-top-color: var(--ink);
  }

  .facet > summary {
    list-style: none;
    cursor: pointer;
    color: var(--ink);
  }

  .facet > summary::-webkit-details-marker {
    display: none;
  }

  .facet > summary::after {
    content: '+' / '';
    float: right;
    color: var(--muted);
  }

  .facet[open] > summary::after {
    content: '–' / '';
  }

  .facet .on {
    color: var(--muted);
  }

  .facet ul {
    margin-top: 6px;
  }

  .fv {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 2px 0;
    font-size: var(--fs-small);
    line-height: 1.35;
    cursor: pointer;
  }

  .fv .count {
    margin-left: 0.15em;
  }

  .fv:has(input:disabled) {
    cursor: default;
    color: var(--muted);
  }

  .fv:has(input:checked) .fv-l {
    font-weight: 600;
  }

  input[type='checkbox'] {
    appearance: none;
    flex: none;
    width: 11px;
    height: 11px;
    margin: 0;
    border: 1px solid var(--muted);
    border-radius: 0;
    background: transparent;
    cursor: inherit;
    transform: translateY(1px);
  }

  input[type='checkbox']:checked {
    background: var(--ink);
    border-color: var(--ink);
  }

  input[type='checkbox']:disabled {
    border-color: var(--rule);
  }

  /* Before the script has applied a filtered URL, keep the unfiltered list out of sight. */
  :global(.cat-pending) .results {
    visibility: hidden;
  }

  @media (max-width: 899px) {
    .cat {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'head' 'rail' 'main';
      padding-top: 36px;
    }

    .rail {
      position: static;
      max-height: none;
      overflow: visible;
      padding: 0;
      margin-bottom: 18px;
    }

    .filters > summary {
      display: block;
      list-style: none;
      padding: 10px 0;
      border-top: 1px solid var(--ink);
      border-bottom: 1px solid var(--rule);
      color: var(--ink);
      cursor: pointer;
    }

    .filters > summary::-webkit-details-marker {
      display: none;
    }

    .filters > summary::after {
      content: '+' / '';
      float: right;
      color: var(--muted);
    }

    .filters[open] > summary::after {
      content: '–' / '';
    }

    .filters[open] > summary {
      border-bottom: 0;
    }

    .facet:first-of-type {
      border-top-color: var(--rule);
    }

    .cat-count {
      min-width: 0;
    }
  }
</style>
