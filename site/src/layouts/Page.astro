---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import newsreader from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import plexMono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/base.ts';

interface Props {
  /** Page title. The site name is appended, except on the home page. */
  title: string;
  description: string;
  /** Nav key of the current page. */
  current?: string;
  /** Hide the top-bar search (the catalog has its own). */
  noSearch?: boolean;
  home?: boolean;
  /** Keep the page out of search indexes (the 404). */
  noindex?: boolean;
}

const { title, description, current, noSearch = false, home = false, noindex = false } = Astro.props;
const siteName = 'Inference Engineering';
const fullTitle = home ? `${siteName}: an atlas of the inference stack` : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('og.png'), Astro.site).href;
const ogTitle = home ? siteName : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <link rel="alternate" type="application/json" href={withBase('api/entries.json')} title="All entries (JSON)" />
    <link rel="alternate" type="text/plain" href={withBase('llms.txt')} title="llms.txt" />
    <link rel="alternate" type="text/plain" href={withBase('llms-full.txt')} title="llms-full.txt" />
    <link rel="preload" href={newsreader} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Inference Engineering: an atlas of the inference stack, from the API request down to the GPU kernel." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Inference Engineering: an atlas of the inference stack, from the API request down to the GPU kernel." />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <TopBar current={current} noSearch={noSearch} />
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/chrome.ts';
    </script>
  </body>
</html>
